{
  "name": "plasma-garden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "container:exec": "docker exec -it plasma-garden-dev bash",
    "container:opencode": "docker exec -it plasma-garden-dev bash -c \"cd /workspaces/plasma-garden && exec opencode\"",
    "container:work": "docker exec -it plasma-garden-dev bash -c \"cd /workspaces/plasma-garden && exec bash\"",
    "container:rm": "docker stop plasma-garden-dev && docker rm plasma-garden-dev"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@webgpu/types": "^0.1.67",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "unplugin-typegpu": "^0.9.0",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
    "@typegpu/noise": "^0.9.0",
    "@typegpu/sdf": "^0.9.0",
    "bitecs": "^0.4.0",
    "typegpu": "^0.9.0",
    "wgpu-matrix": "^3.4.0"
  }
}
